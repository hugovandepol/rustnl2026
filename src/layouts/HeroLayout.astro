---
import Hero from "../components/page/Hero.astro";
import "../styles/index.scss";
import CommonLayout from "./CommonLayout.astro";

interface Props {
  title: string;
  slidedeck?: "rustweek" | "industry";
}

const { title, slidedeck = "rustweek" }: Props = Astro.props;
---

<!doctype html>
<html lang="en">
  <style lang="scss">
    @use "../styles/variables.scss";

    .down-arrow {
      aspect-ratio: 1;
      border: solid variables.$color-red-400;
      border-width: 0 1rem 1rem 0;
      display: inline-block;
      rotate: 0deg;
      animation: MoveUpDown 2s ease-in-out infinite;
      rotate: 45deg;
      width: 3rem;
    }

    @keyframes MoveUpDown {
      0%,
      100% {
        translate: 0 0;
      }
      50% {
        translate: 0 0.4em;
      }
    }

    .leftheader {
      font-size: variables.$font-size-2xl;
    }

    #schedule {
      margin-block-start: 2rem;
    }

    .details-button {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 1em;
    }
  </style>

  <CommonLayout title="RustWeek 2026">
    <Hero style="home" slidedeck={slidedeck}>
      <slot name="hero" />
    </Hero>
    <slot />   
  </CommonLayout>
</html>
