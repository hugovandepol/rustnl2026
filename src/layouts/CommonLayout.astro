---
import Head from "../components/page/head.astro";
import Footer from "../components/page/footer.astro";
import Header from "../components/page/header.astro";
import "../styles/index.scss";

interface Props {
  title: string;
  header?: string;
  withLogo?: boolean;
  withoutMenu?: boolean;
  ogImage?: string;
}

const {
  title,
  header,
  withLogo = true,
  withoutMenu = false,
  ogImage,
} = Astro.props;
---

<style is:global>
  :root {
    --color-background: white;
    
    --color-yellow-000: #FFEDCC;
    --color-yellow-100: #FFDC99;
    --color-yellow-200: #FFCA66;
    --color-yellow-300: #FFB933;
    --color-yellow-400: #FFA700;

    --color-purple-000: #E6D9F2;
    --color-purple-100: #C9A9DC;
    --color-purple-200: #B28DC9;
    --color-purple-300: #9966B2;
    --color-purple-400: #7B3F8C;

    --color-green-000: #D5E8DD;
    --color-green-100: #ABD1BC;
    --color-green-200: #82B99A;
    --color-green-300: #58A279;
    --color-green-400: #2E8B57;

    --color-red-000: #F0D6D1;
    --color-red-100: #E1ADA3;
    --color-red-200: #D18374;
    --color-red-300: #C25A46;
    --color-red-400: #B33118;

    --color-blue-000: #E3ECF5;
    --color-blue-100: #C7D9EB;
    --color-blue-200: #AAC5E0;
    --color-blue-300: #8EB2D6;
    --color-blue-400: #729FCC;

    --color-black: #333333;

    --font-family: "Work Sans", sans-serif;
    --font-family-display: "Alfa Slab One", serif;
    --font-size-scale: 1.333;
    --font-size-base: 1rem;
    --font-size-sm: calc(var(--font-size-base) / var(--font-size-scale));
    --font-size-xs: calc(var(--font-size-sm) / var(--font-size-scale));
    --font-size-md: var(--font-size-base);
    --font-size-lg: calc(var(--font-size-md) * var(--font-size-scale));
    --font-size-xl: calc(var(--font-size-lg) * var(--font-size-scale));
    --font-size-2xl: calc(var(--font-size-xl) * var(--font-size-scale));
    --font-size-3xl: calc(var(--font-size-2xl) * var(--font-size-scale));
    --font-size-body: 1.125rem;

    --font-weight-light: 300;
    --font-weight-bold: 700;

    --line-height-normal: 1.5;
    --line-height-tight: 1.125;
  }

  body {
    color: var(--color-black);
    display: flex;
    flex-direction: column;
    font-family: var(--font-family);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-light);
    line-height: var(--line-height-normal);
    min-height: 100vh;
  }

  main {
    margin-block: 3rem;
    flex: 1;
  }

  main:has(.hero) {
    margin-block-start: 0;
  }

  main:has(.cta) + footer {
    margin-block-start: -3rem;
  }

  .container {
    width: min(100% - 2rem, 88.5rem);
    margin-inline: auto;
  }
</style>

<html lang="en">
  <Head title={`${title} - RustWeek 2026`} ogImage={ogImage} />
  <body>
    <Header withLogo={withLogo} withoutMenu={withoutMenu} />
    <main class="space-y-16 lg:space-y-24">
      <slot />
    </main>
    <Footer />
  </body>
</html>
