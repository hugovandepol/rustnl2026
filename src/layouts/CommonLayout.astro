---
import Head from "../components/page/head.astro";
import Footer from "../components/page/footer.astro";
import Header from "../components/page/header.astro";
import "../styles/index.scss";

interface Props {
  title: string;
  header?: string;
  withLogo?: boolean;
  withoutMenu?: boolean;
  ogImage?: string;
}

const {
  title,
  header,
  withLogo = false,
  withoutMenu = false,
  ogImage,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <Head title={`${title} - RustWeek 2026`} ogImage={ogImage} />

  <body>
    <Header withLogo={withLogo} withoutMenu={withoutMenu} />
    <section class="after-heading">
      {header ? <h1 class="title">{header}</h1> : <slot name="header" />}
      <section>
        <section class="main markdown">
          <slot />
        </section>
        <Footer />
      </section>
    </section>

    <style lang="scss">
      @use "../styles/variables.scss";

      .header {
        width: min(70rem, 90%);

        margin-left: auto;
        margin-right: auto;
      }

      h1.title {
        text-align: center;
        margin-bottom: 3rem;
      }

      .main,
      h1.title {
        width: min(96rem, 90%);
        margin-left: auto;
        margin-right: auto;
        max-width: 100%;
      }

      .main {
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .after-heading {
          margin-top: 4rem;
      }

      body, html, section {
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          // height: 100%;
      }
    </style>
  </body>
</html>
