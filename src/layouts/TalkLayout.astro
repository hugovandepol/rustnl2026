---
import Markdown from "src/components/Markdown.astro";
import CommonLayout from "../layouts/CommonLayout.astro";
import Hero from "src/components/Hero.astro";
import OneColumn from "src/components/OneColumn.astro";
import Person from "src/components/people/Person.astro";
import Divider from "src/components/Divider.astro";
import Cta from 'src/components/Cta.astro';
import Button from "src/components/Button.astro";

const { frontmatter } = Astro.props;
const {
  talkTitle,
  talkLevel,
  url,
  tracks = [],
  day = "tuesday",
  draft = false,
} = frontmatter;

const sep = /\/\/\/\/\/\/.*/;
const content = await Astro.slots.render("default");
const abstract = content.split(sep)[0];
const bio = content.split(sep)[1].replace(/^\n|\n$/g, "");

function list(names: string[]) {
  const finalName = names.pop();
  return names.length ? names.join(", ") + " & " + finalName : finalName;
}

const speaker_names = list(frontmatter.speakers.map((s: any) => s.name));

const ignore = draft ? { "data-pagefind-ignore": "all" } : {};
---

<CommonLayout title={talkTitle} withLogo>
  <Hero
    kicker="Talk"
    title={talkTitle}
    lead={`by ${speaker_names}`}
    color="green"
  >
    {
      talkLevel && (
        <div class="talk-level">
          <strong>Audience:</strong> <span class="tag">{talkLevel}</span>
        </div>
      )
    }
  </Hero>
  <OneColumn>
    <Markdown set:html={abstract} />
  </OneColumn>
  <Divider />
  <OneColumn>
    <div class="persons">
      {
        frontmatter.speakers.map((speaker: any) => (
          <div class="person">
            <Person
              description={bio}
              {...speaker}
              single={frontmatter.speakers.length == 1}
            />
          </div>
        ))
      }
    </div>
  </OneColumn>
  <Cta title="title" lead="lead" color="yellow">
      <div class="buttons">
          {
            !tracks.includes("industry") ? (
              <Button link="https://www.eventbrite.nl/e/rustweek-2025-tickets-1001676961757?aff=oddtdtcreator">
                Get your ticket
              </Button>
            ) : (
              <Button link="https://www.eventbrite.nl/e/industry-track-rustweek-2025-tickets-1115250035879">
                Get your ticket
              </Button>
            )
          }
          {
            day && (
              <Button link={`/schedule/${day}/#${url.split('/').pop()}`}>
                Find in timetable
              </Button>
            )
          }
        </div>
  </Cta>
</CommonLayout>

<style>
  .persons {
    display: flex;
    gap: 2rem;
  }

  .persons > .person {
    flex: 1;
  }

  .talk-level {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .talk-level .tag {
    background-color: var(--color-yellow-400);
    padding-inline: 0.75rem;
    border-radius: 0.25rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
  }

  .cutout.cutout-button-group.custom::after {
    inset: -55%;
  }  
</style>
