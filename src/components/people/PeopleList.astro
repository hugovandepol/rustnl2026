---
interface Props {
  title?: string;
  lead?: string;
}

const { title, lead }: Props = Astro.props;
---

<style lang="scss">
  .header {
    align-items: center;
    display: flex;
    flex-direction: column;
    text-align: center;
    margin-block-end: 1.5rem;
  }

  .people {
    display: grid;
    gap: 1.5em;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
</style>

<div class="container">
  {
    title && (
      <div class="header">
        <h2>{title}</h2>
        {lead && <p>{lead}</p>}
      </div>
    )
  }
  <div class="people">
    <slot />
  </div>
</div>
