---
interface Props {
  kicker?: string;
  title: string;
  lead?: string;
  color?: 'yellow' | 'purple' | 'red' | 'blue' | 'green';
}

const { 
  kicker, 
  title, 
  lead,
  color = 'purple'
} = Astro.props;

// Map color to shade variables
const color000 = `var(--color-${color}-000)`;
const color100 = `var(--color-${color}-100)`;
const color300 = `var(--color-${color}-300)`;
const color400 = `var(--color-${color}-400)`;
---

<div class="hero">
  <div class="container">
    {kicker && <div class="kicker">{kicker}</div>}
    <h1>{title}</h1>
    {lead && <p>{lead}</p>}
  </div>
</div>

<style lang="scss" define:vars={{ color000, color100, color300, color400 }}>
  .hero {
    background-color: var(--color400);
    margin-block-end: 3rem;
    // padding-block: 3rem;
  }

  .hero > .container {
    align-items: center;
    background-color: var(--color000);
    border-bottom-right-radius: 4.5rem;
    border-top-left-radius: 4.5rem;
    display: flex;
    flex-direction: column;
    gap: 1lh;
    padding-block: 4.5rem;
    text-align: center;
  }

  .kicker {
    text-transform: uppercase;
    color: var(--color200);
  }

  p {
    font-size: var(--font-size-lg);
  }

  h1 {
    font-family: var(--font-family-display);
    font-size: var(--font-size-2xl);
    text-wrap: balance;
  }
</style>
