---
interface Props {
    link: string;
    ty?: "primary" | "secondary" | "primary-10";
    inFooter?: boolean;
    scale?: number;
}

const { link, ty = "primary", inFooter = false, scale = 1 }: Props = Astro.props;

---

<a
    class:list={["button button-primary", ty, inFooter ? "footer" : null]}
    href={link}
>
    <slot>{link}</slot>
</a>

<style lang="scss" define:vars={{ scale }}>
    @use "../styles/global/buttons.scss";
</style>
