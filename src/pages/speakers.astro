---
import Hero from "src/components/Hero.astro";
import PeopleList from "../components/people/PeopleList.astro";
import CommonLayout from "../layouts/CommonLayout.astro";
import { useData } from "../components/useData";
import { getCollection } from "astro:content";
import Speaker from "src/components/people/Speaker.astro";

const people = await getCollection("people");
const { greg, taylor, andreea, andreea2 } = useData(people);
const speakers = [taylor, greg, andreea, andreea2];
---

<CommonLayout title="Speakers" withLogo>
  <div>
    <img data-pagefind-meta="image[src]" style="display: none;" />
    <Hero title="Speakers" lead="This year speakers" color="yellow" />
    <PeopleList>
      {
        speakers.map((speaker) => (
          <Speaker talkId={speaker.talk.id} tile {...speaker} />
        ))
      }
    </PeopleList>
  </div>
</CommonLayout>
